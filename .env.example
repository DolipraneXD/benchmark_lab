# Copy to .env (git-ignored). BenchLab reads keys ONLY through the env var
# named in each model's `api_key_env` in models.yaml. Keys are never written
# to run folders, logs or reports.

ANTHROPIC_API_KEY=
GLM_API_KEY=
DEEPSEEK_API_KEY=
MIMO_API_KEY=
MISTRAL_API_KEY=
STEP_API_KEY=
OPENROUTER_API_KEY=

# self-hosted vLLM / TEI endpoints usually accept any token
VLLM_API_KEY=EMPTY

# Bedrock uses the standard AWS credential chain
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1

# LiteLLM proxy (harnesses talk to http://localhost:4000/v1 with this key)
LITELLM_MASTER_KEY=sk-benchlab-local
